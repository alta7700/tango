{
  "name": "tango",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'tests/e2e/**'",
    "build:standalone": "VITE_GAME_PLATFORM=standalone vite build --outDir dist/standalone",
    "build:yandex": "VITE_GAME_PLATFORM=yandex vite build --outDir dist/yandex",
    "build": "npm run build:standalone && npm run build:yandex",
    "preview:standalone": "vite preview --outDir dist/standalone --host 127.0.0.1 --port 4273 --strictPort",
    "preview:yandex": "vite preview --outDir dist/yandex --host 127.0.0.1 --port 4274 --strictPort",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
